{
    "$schema": "/etc/xdg/swaync/configschema.json",

    // --- Position & sizing ---
    "positionX": "right",
    "positionY": "top",
    "cssPriority": "user",
    "control-center-width": 420,
    "control-center-height": 640,
    "control-center-margin-top": 8,
    "control-center-margin-right": 8,
    "control-center-margin-bottom": 0,
    "control-center-margin-left": 0,
    "fit-to-screen": false,

    // --- Notification popup window ---
    "notification-window-width": 390,
    "notification-icon-size": 44,
    "notification-body-image-height": 500,
    "notification-body-image-width": 500,
    "notification-inline-replies": true,
    "notification-2fa-action": false,
    "notification-visibility": {
        "app-visibility-all": {
            "state": "enabled"
        }
    },

    // --- Timeouts (seconds) ---
    "timeout": 4,
    "timeout-low": 2,
    "timeout-critical": 0,

    // --- Behaviour ---
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "script-fail-notify": true,
    "layer": "overlay",
    "control-center-layer": "overlay",

    // --- Widget order ---
    "widgets": [
        "title",
        "buttons-grid",
        "mpris",
        "volume",
        "backlight",
        "dnd",
        "notifications"
    ],

    // --- Widget configuration ---
    "widget-config": {

        "title": {
            "text": "✦ Arcane",
            "clear-all-button": true,
            "button-text": "󰃢 Clear"
        },

        "backlight": {
            "device": "amdgpu_bl1",
            "label": "󰃠",
            "slider": true,
            "min": 10
        },

        "volume": {
            "device": "default",
            "label": "",
            "slider": true
        },

        "dnd": {
            "text": "Do not disturb"
        },

        "mpris": {
            "image-size": 100,
            "image-radius": 10,
            "autohide": true,
            "blacklist": ["org.mpris.MediaPlayer2.playerctld"]
        },

        "buttons-grid": {
            "actions": [
                {
                    "label": "󰌪",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.local/bin/powerprofile --toggle-quiet'",
                    "update-command": "bash -c '$HOME/.local/bin/powerprofile --is-quiet'"
                },
                {
                    "label": "",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.local/bin/caffeine'",
                    "update-command": "bash -c '$HOME/.local/bin/caffeine --is-running'"
                },
                {
                    "label": "",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.local/bin/mictoggle --silent'",
                    "update-command": "bash -c '$HOME/.local/bin/mictoggle --is-muted'"
                },
                {
                    "label": "",
                    "command": "hyprctl dispatch exec alacritty -- -e htop ; swaync-client -cp"
                },
                {
                    "label": "󰃟",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.local/bin/themesw'",
                    "update-command": "bash -c '[ $($HOME/.local/bin/themesw --current) = light ] && echo true || echo false'"
                },
                {
                    "label": "",
                    "command": "hyprctl dispatch exec nwg-look ; swaync-client -cp"
                },
                {
                    "label": "",
                    "command": "swaync-client -cp ; bash -c $HOME/.config/rofi/bin/logout"
                }
            ]
        }
    }
}