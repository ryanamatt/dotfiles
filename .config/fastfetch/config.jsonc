{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // --- Logo ---
    "logo": {
        "source": "/home/ryan/.config/fastfetch/art.txt",
        "type": "file",
        "color": {
            "1": "bright_magenta",
            "2": "magenta"
        },
        "padding": {
            "top": 1,
            "right": 4,
            "left": 1
        }
    },

    // --- Display ---
    "display": {
        "separator": " │ ",
        "color": {
            "keys": "magenta",
            "title": "bright_magenta",
            "separator": "magenta"
        },
        "brightColor": true,
        "key": {
            "width": 16,
            "type": "string"
        },
        "bar": {
            "char": {
                "elapsed": "▓",
                "total": "░"
            },
            "border": {
                "left": "❬",
                "right": "❭"
            },
            "width": 10
        },
        "percent": {
            "type": 9
        },
        "temp": {
            "unit": "C"
        },
        "duration": {
            "abbreviation": true
        }
    },

    // --- Modules ---
    "modules": [

        // --- Title ---
        {
            "type": "title",
            "key": " ",
            "format": "\u001b[1;95m{user-name}\u001b[0m\u001b[35m@\u001b[0m\u001b[1;95m{host-name}\u001b[0m"
        },

        // Top border of the table
        {
            "type": "custom",
            "format": "\u001b[35m╭─────────────┬────────────────────────╮\u001b[0m"
        },

        // --- System ---
        {
            "type": "os",
            "key": "│ 󰣇  OS      ",
            "keyColor": "magenta",
            "format": "{2}              \u001b[35m│\u001b[0m"
        },
        {
            "type": "kernel",
            "key": "│ 󰌽  Kernel  ",
            "keyColor": "magenta",
            "format": "{2}        \u001b[35m│\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "│ 󱦟  Uptime  ",
            "keyColor": "magenta",
            "format": "lua:local u = ...; return string.format('%-4dh %02dm %02ds           \u001b[35m│\u001b[0m', (u.days * 24) + u.hours, u.minutes, u.seconds)"
        },
        {
            "type": "packages",
            "key": "│ 󰏗  Pkgs    ",
            "keyColor": "magenta",
            "format": "{pacman} pkgs, {flatpak-system} flatpak    \u001b[35m│\u001b[0m"
        },
        {
            "type": "shell",
            "key": "│   Shell   ",
            "keyColor": "magenta",
            "format": "{pretty-name} {version}              \u001b[35m│\u001b[0m"
        },

        // Section divider
        {
            "type": "custom",
            "format": "\u001b[35m├─────────────┼────────────────────────┤\u001b[0m"
        },

        // --- Desktop ---
        {
            "type": "wm",
            "key": "│ 󱂬  WM      ",
            "keyColor": "magenta",
            "format": "{pretty-name} {version}         \u001b[35m│\u001b[0m"
        },
        {
            "type": "terminal",
            "key": "│   Term    ",
            "keyColor": "magenta",
            "format": "{pretty-name} {version}            \u001b[35m│\u001b[0m"
        },
        {
            "type": "terminalfont",
            "key": "│   Font    ",
            "keyColor": "magenta",
            "format": "{name}\u001b[35m│\u001b[0m"
        },
        {
            "type": "theme",
            "key": "│ 󰟡  Theme   ",
            "keyColor": "magenta",
            "format": "{name}\u001b[35m│\u001b[0m"
        },
        {
            "type": "icons",
            "key": "│ 󰀻  Icons   ",
            "keyColor": "magenta",
            "format": "{name}\u001b[35m│\u001b[0m"
        },
        {
            "type": "cursor",
            "key": "│ 󰇀  Cursor  ",
            "keyColor": "magenta",
            "format": "{theme}                 \u001b[35m│\u001b[0m"
        },

        // Section divider
        {
            "type": "custom",
            "format": "\u001b[35m├─────────────┼────────────────────────┤\u001b[0m"
        },

        // --- Hardware ---
        {
            "type": "host",
            "key": "│ 󰌢  Host    ",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "│   CPU     ",
            "keyColor": "magenta",
            "showPeCoreCount": false,
            "format": "13G Intel i9-13900KF    \u001b[35m│\u001b[0m"
        },
        {
            "type": "gpu",
            "key": "│ 󰍛  GPU     ",
            "keyColor": "magenta",
            "format": "GeForce RTX 3090        \u001b[35m│\u001b[0m"
        },
        {
            "type": "memory",
            "key": "│ 󰘓  Memory  ",
            "keyColor": "magenta",
            "format": "lua:local m = ...; return string.format('%4s / %-4s    \u001b[35m│\u001b[0m', m.used, m.total)",
            "percent": { "type": 8 }
        },
        {
            "type": "disk",
            "key": "│ 󰋊  Root    ",
            "keyColor": "magenta",
            "folders": "/",
            "format": "{size-used} / {size-total}   \u001b[35m│\u001b[0m",
            "percent": { "type": 8 }
        },
        {
            "type": "disk",
            "key": "│ 󰋊  Home    ",
            "keyColor": "magenta",
            "folders": "/home",
            "format": "{size-used} / {size-total}   \u001b[35m│\u001b[0m",
            "percent": { "type": 8 }
        },
        {
            "type": "disk",
            "key": "│ 󰉉  Boot    ",
            "keyColor": "magenta",
            "folders": "/boot",
            "format": "{size-used} / {size-total}   \u001b[35m│\u001b[0m",
            "percent": { "type": 8 }
        },
        {
            "type": "disk",
            "key": "│ 󰒋  Storage ",
            "keyColor": "magenta",
            "folders": "/mnt/storage",
            "format": "{size-used} / {size-total}   \u001b[35m│\u001b[0m",
            "percent": { "type": 8 }
        },
        {
            "type": "battery",
            "key": "│ 󰁹  Battery ",
            "keyColor": "magenta"
        },

        // Bottom border of the table
        {
            "type": "custom",
            "format": "\u001b[35m╰─────────────┴────────────────────────╯\u001b[0m"
        },

        "break",

        // --- Color swatches ---
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
