{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // --- Logo ---
    "logo": {
        "source": "/home/ryan/.config/fastfetch/art.txt",
        "type": "file",
        "color": {
            "1": "bright_magenta",
            "2": "magenta"
        },
        "padding": {
            "top": 1,
            "right": 4,
            "left": 1
        }
    },

    // --- Display ---
    "display": {
        "separator": "  ❯  ",
        "color": {
            "keys": "magenta",
            "title": "bright_magenta",
            "separator": "bright_magenta"
        },
        "brightColor": true,
        "key": {
            "width": 13,
            "type": "string"
        },
        "bar": {
            "char": {
                "elapsed": "▓",
                "total": "░"
            },
            "border": {
                "left": "❬",
                "right": "❭"
            },
            "width": 10
        },
        "percent": {
            "type": 9
        },
        "temp": {
            "unit": "C"
        },
        "duration": {
            "abbreviation": true
        }
    },

    // --- Modules ---
    "modules": [

        // --- Title ---
        {
            "type": "title",
            "key": " ",
            "format": "\u001b[1;95m{user-name}\u001b[0m\u001b[35m@\u001b[0m\u001b[1;95m{host-name}\u001b[0m"
        },
        {
            "type": "separator",
            "string": "─",
            "length": 38
        },

        // --- System ---
        {
            "type": "os",
            "key": "󰣇  OS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "󱦟  Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏗  Pkgs",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "magenta"
        },

        "break",

        // --- Desktop ---
        {
            "type": "wm",
            "key": "󱂬  WM",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "  Term",
            "keyColor": "magenta"
        },
        {
            "type": "terminalfont",
            "key": "  Font",
            "keyColor": "magenta"
        },
        {
            "type": "theme",
            "key": "󰟡  Theme",
            "keyColor": "magenta"
        },
        {
            "type": "icons",
            "key": "󰀻  Icons",
            "keyColor": "magenta"
        },
        {
            "type": "cursor",
            "key": "󰇀  Cursor",
            "keyColor": "magenta"
        },

        "break",

        // --- Hardware ---
        {
            "type": "host",
            "key": "󰌢  Host",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "  CPU",
            "keyColor": "magenta",
            "showPeCoreCount": false
        },
        {
            "type": "gpu",
            "key": "󰍛  GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "󰘓  Memory",
            "keyColor": "magenta",
            "percent": { "type": 9 }
        },
        {
            "type": "disk",
            "key": "󰋊  Root",
            "keyColor": "magenta",
            "folders": "/",
            "percent": { "type": 9 }
        },
        {
            "type": "disk",
            "key": "󰋊  Home",
            "keyColor": "magenta",
            "folders": "/home",
            "percent": { "type": 9 }
        },
        {
            "type": "disk",
            "key": "󰉉  Boot",
            "keyColor": "magenta",
            "folders": "/boot",
            "percent": { "type": 9 }
        },
        {
            "type": "disk",
            "key": "󰒋  Storage",
            "keyColor": "magenta",
            "folders": "/mnt/storage",
            "percent": { "type": 9 }
        },
        {
            "type": "battery",
            "key": "󰁹  Battery",
            "keyColor": "magenta"
        },

        "break",

        {
            "type": "command",
            "key": "Theme",
            "text": "cat ~/dotfiles/themes/.current_theme"
        },

        {
            "type": "command",
            "key": "󰄳 Todo",
            "text": "todo list --pending --compact --limit 4 --indent 36 --width 40"
        },

        "break",

        // --- Color swatches ---
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}