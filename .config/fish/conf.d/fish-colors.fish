
# --- Syntax highlighting ---
set -g fish_color_normal              dde3ee
set -g fish_color_command             c2c2f9
set -g fish_color_keyword             bac6ea
set -g fish_color_quote               3b4664
set -g fish_color_redirection         54d5ff
set -g fish_color_end                 414750
set -g fish_color_error               ffb4ab --underline
set -g fish_color_param               dde3ee
set -g fish_color_color_comment       242a33
set -g fish_color_operator            e1c700
set -g fish_color_escape              54d5ff
set -g fish_color_cancel              ffb4ab
set -g fish_color_history_current     bac6ea --bold
set -g fish_color_valid_path          dde3ee --underline
set -g fish_color_autosuggestion      414750
set -g fish_color_selection           white --background=0e141c
set -g fish_color_search_match        dde3ee --background=0e141c

# --- Pager (tab completions) ---
set -g fish_pager_color_completion            dde3ee
set -g fish_pager_color_description           414750 --italics
set -g fish_pager_color_prefix                c2c2f9 --bold --underline
set -g fish_pager_color_progress              414750 --italics
set -g fish_pager_color_secondary_completion  dde3ee --background=1a2028
set -g fish_pager_color_secondary_description 414750 --italics --background=1a2028
set -g fish_pager_color_secondary_prefix      c2c2f9 --bold
set -g fish_pager_selected_completion         0e141c --background=a0c9ff
set -g fish_pager_selected_description        0e141c --background=a0c9ff --italics
set -g fish_pager_selected_prefix             0e141c --background=a0c9ff --bold