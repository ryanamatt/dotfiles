{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // --- Logo ---
    "logo": {
        "type": "data",
        // "source": "   .  *  .    *   .    *   .   *  .\n *   .    *  .  *   .    *   .    *\n  .    *    .    .  *    .  *   .  \n    *   .  *   .      .      *    .\n  .   *   .   *  \\/  /\\   .   *   \n *  .    .    |\\  \\/  /|    .    * \n   .  *    .  | >-/\\/-< |  .  *   .\n .    .  *    |/  /\\  \\|    *    . \n  *  .  .   * /  /  \\  \\  .   *  .\n   .    *   ./  / .  .\\  \\.  .    *\n  .  *    . /.-'  *  '-.\\ .  *  .  \n *  .  *   |   .  \\/  .  |   .    *\n   .    .  |  *  /||\\  * |  .   *  \n  *  .   . | .  / || \\  .|  *  .  .\n   .  *    |   / /|\\ \\  |    .  * \n  .    .  *\\  /_/ || \\_\\ /*  .    .\n *   .   .  \\/  / || \\  \\/  .  *  .\n   *  .  .   \\ /  ||  \\ /  .    *  \n  .    *   .  X   ||   X  .  *   . \n *   .   .   /|\\  ||  /|\\   .  *  .\n   .  *  .  / | \\ || / | \\  .    * \n  .    *   '  |  \\||/  |  '   *  . \n *  .   .     |   \\/   |    .    * \n   .  *    .  '   /\\   '  .   *  . \n  .    .  *      /  \\     *  .    .\n *   .   .      / ** \\      .  *  .\n   *  .  .     /  **  \\    .    *  \n  .    *   .  / * \\/ * \\  .  *   .\n *   .   .   '    ~~~~   '  .  *  .\n   .  *  .     *   ..   *    .    *",
        "source": "                \\||/\n                |  @___oo\n      /\\  /\\   / (__,,,,|\n     ) /^\\) ^\\/ _)\n     )   /^\\/   _)\n     )   _ /  / _)\n /\\  )/\\/ ||  | )_)\n<  >      |(,,) )__)\n ||      /    \\)___)\\\n | \\____(      )___) )___\n  \\______(_______;;; __;;;",
        "color": {
            "1": "bright_magenta",
            "2": "magenta"
        },
        "padding": {
            "top": 1,
            "right": 4,
            "left": 1
        }
    },

    // --- Display ---
    "display": {
        "separator": "  \u276f  ",
        "color": {
            "keys": "magenta",
            "title": "bright_magenta",
            "separator": "bright_magenta"
        },
        "brightColor": true,
        "key": {
            "width": 12,
            "type": "string"
        },
        "bar": {
            "char": {
                "elapsed": "▓",
                "total": "░"
            },
            "border": {
                "left": "❬",
                "right": "❭"
            },
            "width": 10
        },
        "percent": {
            "type": 9
        },
        "temp": {
            "unit": "C"
        },
        "duration": {
            "abbreviation": true
        }
    },

    // --- Modules ---
    "modules": [

        // --- Title ---
        {
            "type": "title",
            "key": " ",
            "format": "\u001b[1;95m{user-name}\u001b[0m\u001b[35m@\u001b[0m\u001b[1;95m{host-name}\u001b[0m"
        },
        {
            "type": "separator",
            "string": "─",
            "length": 38
        },

        // --- System ---
        {
            "type": "os",
            "key": "󰣇  OS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "󰌽  Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "󱦟  Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏗  Pkgs",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "magenta"
        },

        "break",

        // --- Desktop ---
        {
            "type": "wm",
            "key": "󱂬  WM",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "  Term",
            "keyColor": "magenta"
        },
        {
            "type": "terminalfont",
            "key": "  Font",
            "keyColor": "magenta"
        },
        {
            "type": "theme",
            "key": "󰟡  Theme",
            "keyColor": "magenta"
        },
        {
            "type": "icons",
            "key": "󰀻  Icons",
            "keyColor": "magenta"
        },
        {
            "type": "cursor",
            "key": "󰇀  Cursor",
            "keyColor": "magenta"
        },

        "break",

        // --- Hardware ---
        {
            "type": "host",
            "key": "󰌢  Host",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "  CPU",
            "keyColor": "magenta",
            "showPeCoreCount": false
        },
        {
            "type": "gpu",
            "key": "󰍛  GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "󰘓  Memory",
            "keyColor": "magenta",
            "percent": { "type": 9 }
        },
        {
            "type": "disk",
            "key": "󰋊  Disk",
            "keyColor": "magenta",
            "folders": "/",
            "percent": { "type": 9 }
        },
        {
            "type": "battery",
            "key": "󰁹  Battery",
            "keyColor": "magenta"
        },
        {
            "type": "localip",
            "key": "󰀂  Local IP",
            "keyColor": "magenta"
        },

        "break",

        // --- Color swatches ---
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}