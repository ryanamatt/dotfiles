# hyprlock.conf
#
# Palette:
{% set swatches = [semantic.background, semantic.alt_surface, semantic.cursor, semantic.active_border, semantic.fish_commands, semantic.text_primary, semantic.text_secondary, semantic.warning, semantic.error, semantic.success] %}
{% for pair in swatches | unique(attribute='name') | batch(2) %}
#   {{ "%-9s %s" | format(pair[0].name, pair[0].hex) }}{% if pair|length > 1 %}    {{ "%-9s %s" | format(pair[1].name, pair[1].hex) }}{% endif %}

{% endfor %}
#
# shortcuts: ESC, Ctrl+U, Ctrl+Backspace -- clear password buffer

$font        = {{ typography.hyprlock }}
$font_bold   = {{ typography.hyprlock }}

# --- General ---
general {
    hide_cursor      = true
    grace            = 0
    no_fade_in       = false
    no_fade_out      = false
    ignore_empty_input = false
}

# --- Animations ---
animations {
    enabled = true

    bezier = voidRise,  0.23, 1,    0.32, 1      # easeOutQuint -- matches Hyprland
    bezier = voidFade,  0.5,  0.5,  0.75, 1      # almostLinear
    bezier = linear,    1,    1,    0,    0

    animation = fadeIn,           1, 6,  voidRise
    animation = fadeOut,          1, 4,  voidFade
    animation = inputFieldDots,   1, 3,  voidRise
    animation = inputFieldFade,   1, 4,  voidFade
    animation = inputFieldWidth,  1, 5,  voidRise
}

# --- Background ---
# Screenshot of the desktop, heavily blurred + darkened into the void
background {
    monitor =
    path         = screenshot
    blur_passes  = {{ transparency.hyprlock_bg.blur_passes }}
    blur_size    = {{ transparency.hyprlock_bg.blur_size }}
    brightness   = {{ transparency.hyprlock_bg.brightness }}
    contrast     = 0.9
    vibrancy     = 0.2
    vibrancy_darkness = 0.6
}

# --- Clock -- large, centered ---
label {
    monitor =
    text      = $TIME
    font_size = 96
    font_family = $font_bold
    color     = {{ semantic.text_primary.hl('ff') }}       # {{ semantic.text_primary.name }}

    shadow_passes = 3
    shadow_size   = 10
    shadow_color  = {{ semantic.active_border.hl('60') }}   # {{ semantic.active_border.name }} glow

    position = 0, 120
    halign   = center
    valign   = center
}

# --- Date ---
label {
    monitor =
    text      = cmd[update:60000] date +"%A, %d %B %Y"
    font_size = 22
    font_family = $font
    color     = {{ semantic.cursor.hl('ff') }}       # {{ semantic.cursor.name }}

    shadow_passes = 2
    shadow_size   = 6
    shadow_color  = {{ semantic.background.hl('80') }}

    position = 0, 52
    halign   = center
    valign   = center
}

# --- Flavor text -- arcane inscription above the input field ---
label {
    monitor =
    text      = {{ glyphs.flavor_star }}  {{ text.hyprlock_text }}  {{ glyphs.flavor_star }}
    font_size = 13
    font_family = $font
    color     = {{ semantic.text_secondary.hl('cc') }}       # {{ semantic.text_secondary.name }}, slightly transparent

    position = 0, -60
    halign   = center
    valign   = center
}

# --- Password input field ---
input-field {
    monitor =
    size             = 380, 52
    outline_thickness = 2
    rounding         = 12

    # Transparent fill -- blur behind shows through
    inner_color      = {{ semantic.surface.hl('80') }}

    # Idle border: {{ semantic.cursor.name }} → {{ semantic.fish_commands.name }} gradient
    outer_color      = {{ semantic.cursor.hl('ff') }} {{ semantic.fish_commands.hl('ff') }} 45deg

    # Checking: {{ semantic.warning.name }} pulse
    check_color      = {{ semantic.warning.hl('ff') }} {{ semantic.cursor.hl('ff') }} 90deg

    # Fail: rose red
    fail_color       = {{ semantic.error.hl('ff') }} {{ semantic.active_border.hl('ff') }} 40deg

    font_color       = {{ semantic.text_primary.hl('ff') }}  # {{ semantic.text_primary.name }}
    font_family      = $font

    fade_on_empty    = true
    placeholder_text = <i>passphrase...</i>
    fail_text        = <b>$PAMFAIL</b>
    check_text       = <i>divining...</i>

    dots_size        = 0.28
    dots_spacing     = 0.35
    dots_center      = true

    position = 0, -20
    halign   = center
    valign   = center
}

# --- User / avatar label ---
label {
    monitor =
    text      =  $USER
    font_size = 16
    font_family = $font
    color     = {{ semantic.fish_strings.hl('ff') }}       # bloom lavender

    shadow_passes = 1
    shadow_size   = 4
    shadow_color  = {{ semantic.background.hl('99') }}

    position = 0, 30
    halign   = center
    valign   = center
}

# --- Keyboard layout indicator ---
label {
    monitor =
    text    = $LAYOUT[en,ru]
    font_size = 14
    font_family = $font
    color   = {{ semantic.text_secondary.hl('99') }}         # {{ semantic.text_secondary.name }}, dim

    onclick = hyprctl switchxkblayout all next

    position = 0, -90
    halign   = center
    valign   = center
}
