/* {{ name }} Theme */

/* --- Backgrounds --- */
@define-color bg0        {{ semantic.background }};
@define-color bg1        {{ semantic.surface }};
@define-color bg2        {{ semantic.surface_mid }};
@define-color bg3        {{ semantic.alt_surface }};
@define-color bg4        {{ semantic.hover }};

/* --- Foregrounds --- */
@define-color fg         {{ semantic.text_primary }};
@define-color silver     {{ palette.silver }};
@define-color mist       {{ semantic.text_secondary }};

/* --- Accent colours (keep gruvbox semantic names for style.css) --- */
@define-color red        {{ semantic.error }};
@define-color orange     {{ palette.ember }};
@define-color yellow     {{ semantic.warning }};
@define-color green      {{ semantic.success }};
@define-color aqua       {{ ansi_by_index[6].hex }};
@define-color blue       {{ ansi_by_index[12].hex }};
@define-color purple     {{ semantic.cursor }};
@define-color dark-purple {{ semantic.active_border }};
@define-color fae        {{ semantic.fish_commands }};

/* --- Greys (kept for any downstream use) --- */
@define-color grey0      {{ semantic.text_secondary }};
@define-color grey1      {{ palette.grey1 }};
@define-color grey2      {{ extra.autosuggestions }};

/* --- Text --- */
@define-color text              {{ semantic.text_primary }};
@define-color text-alt          {{ semantic.text_secondary }};

/* --- Backgrounds --- */
@define-color background        {{ semantic.surface }};
@define-color background-alt    {{ semantic.surface_mid }};

/* --- Notification surfaces --- */
@define-color notification-bg         {{ semantic.surface }};
@define-color center-bg               alpha({{ semantic.background }}, {{ transparency.swaync_center.alpha }});
@define-color center-notification-bg  {{ semantic.surface_mid }};

/* --- Interactive states --- */
@define-color hover             {{ semantic.hover }};
@define-color selected          {{ semantic.selected }};

/* --- Semantic accents --- */
@define-color urgent            {{ semantic.error }};
@define-color accent            {{ semantic.cursor }};
